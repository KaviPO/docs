{
  "openapi": "3.0.1",
  "info": {
    "title": "Payment Options API",
    "description": "GCash E-Walletの直接決済（購入／オーソリ）に関するAPIリファレンス。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-dev.paymentoptions.com"
    }
  ],
  "security": [
    {
      "apiKeyAuth": [],
      "xApiKeyAuth": []
    }
  ],
  "paths": {
    "/api/v1/server-to-server-interface/payment": {
      "post": {
        "summary": "GCashウォレット連携（購入／オーソリ）",
        "description": "Direct Payment APIを使用してGCashの購入／オーソリ取引を開始します。レスポンスには、お客様が決済を行うための決済ページURLが含まれます。",
        "operationId": "createGcashPayment",
        "requestBody": {
          "description": "GCash直接決済のリクエストデータ。",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "amount",
                  "currency",
                  "payment_method",
                  "merchant_id",
                  "return_url",
                  "billing_address",
                  "time_zone"
                ],
                "properties": {
                  "amount": {
                    "description": "取引金額。金額の上限は銀行によって異なります。",
                    "example": "200",
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "currency": {
                    "type": "string",
                    "description": "決済処理に使用する3文字の通貨コード。",
                    "maxLength": 3,
                    "example": "USD"
                  },
                  "payment_method": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "決済方法の詳細を含むJSONオブジェクト。",
                    "properties": {
                      "type": {
                        "type": "string",
                        "description": "GCashの決済方法識別子。",
                        "maxLength": 128,
                        "example": "gcash",
                        "enum": [
                          "gcash"
                        ]
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "merchant_txn_ref": {
                    "type": "string",
                    "description": "加盟店の取引参照ID。",
                    "maxLength": 45,
                    "example": "ORDER-12345"
                  },
                  "customer_ip": {
                    "type": "string",
                    "description": "取引を開始するお客様のIPアドレス。",
                    "example": "192.0.2.10",
                    "maxLength": 45
                  },
                  "merchant_id": {
                    "type": "string",
                    "description": "加盟店の一意の識別子（DASMID）。",
                    "maxLength": 128,
                    "example": "<DASMID>"
                  },
                  "return_url": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "決済通知およびリダイレクト先のURL設定。",
                    "properties": {
                      "webhook_url": {
                        "type": "string",
                        "description": "非同期通知を受信するWebhook URL。",
                        "maxLength": 255,
                        "example": "https://merchant.example.com/webhook"
                      },
                      "success_url": {
                        "type": "string",
                        "description": "決済成功後にお客様をリダイレクトするURL。",
                        "maxLength": 255,
                        "example": "https://merchant.example.com/success"
                      },
                      "decline_url": {
                        "type": "string",
                        "description": "決済失敗後にお客様をリダイレクトするURL。",
                        "maxLength": 255,
                        "example": "https://merchant.example.com/decline"
                      }
                    }
                  },
                  "billing_address": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "お客様の請求先住所を含むJSONオブジェクト。",
                    "properties": {
                      "country": {
                        "type": "string",
                        "description": "お客様の請求先国コード。",
                        "maxLength": 2,
                        "example": "JP"
                      },
                      "email": {
                        "type": "string",
                        "description": "お客様の請求先メールアドレス。",
                        "maxLength": 45,
                        "example": "customer@example.com"
                      },
                      "phone_number": {
                        "type": "string",
                        "description": "お客様の請求先電話番号。",
                        "maxLength": 20,
                        "example": "8112345678"
                      },
                      "address1": {
                        "type": "string",
                        "description": "お客様の請求先住所（番地など）。",
                        "maxLength": 199,
                        "example": "1-2-3 Shinjuku"
                      },
                      "city": {
                        "type": "string",
                        "description": "お客様の請求先市区町村。",
                        "maxLength": 65,
                        "example": "Shinjuku-ku"
                      },
                      "state": {
                        "type": "string",
                        "description": "お客様の請求先都道府県・州。",
                        "maxLength": 65,
                        "example": "Tokyo"
                      },
                      "postal_code": {
                        "type": "string",
                        "description": "お客様の請求先郵便番号。",
                        "maxLength": 45,
                        "example": "1600022"
                      }
                    },
                    "required": [
                      "country",
                      "email",
                      "address1",
                      "phone_number",
                      "city",
                      "postal_code"
                    ]
                  },
                  "shipping_address": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "お客様の配送先住所を含むJSONオブジェクト。",
                    "properties": {
                      "country": {
                        "type": "string",
                        "description": "お客様の配送先国コード。",
                        "maxLength": 2,
                        "example": "JP"
                      },
                      "email": {
                        "type": "string",
                        "description": "お客様の配送先メールアドレス。",
                        "maxLength": 45,
                        "example": "customer@example.com"
                      },
                      "phone_number": {
                        "type": "string",
                        "description": "お客様の配送先電話番号。",
                        "maxLength": 20,
                        "example": "8112345678"
                      },
                      "address1": {
                        "type": "string",
                        "description": "お客様の配送先住所（番地など）。",
                        "maxLength": 199,
                        "example": "1-2-3 Shinjuku"
                      },
                      "city": {
                        "type": "string",
                        "description": "お客様の配送先市区町村。",
                        "maxLength": 65,
                        "example": "Shinjuku-ku"
                      },
                      "state": {
                        "type": "string",
                        "description": "お客様の配送先都道府県・州。",
                        "maxLength": 65,
                        "example": "Tokyo"
                      },
                      "postal_code": {
                        "type": "string",
                        "description": "お客様の配送先郵便番号。",
                        "maxLength": 45,
                        "example": "1600022"
                      }
                    }
                  },
                  "time_zone": {
                    "type": "string",
                    "description": "取引に適用するタイムゾーン。",
                    "example": "Asia/Kuala_Lumpur",
                    "maxLength": 128
                  }
                },
                "example": {
                  "amount": "200",
                  "currency": "USD",
                  "payment_method": {
                    "type": "gcash"
                  },
                  "merchant_txn_ref": "ORDER-12345",
                  "customer_ip": "192.0.2.10",
                  "merchant_id": "<DASMID>",
                  "return_url": {
                    "webhook_url": "https://merchant.example.com/webhook",
                    "success_url": "https://merchant.example.com/success",
                    "decline_url": "https://merchant.example.com/decline"
                  },
                  "billing_address": {
                    "country": "JP",
                    "email": "customer@example.com",
                    "address1": "1-2-3 Shinjuku",
                    "phone_number": "8112345678",
                    "city": "Shinjuku-ku",
                    "state": "Tokyo",
                    "postal_code": "1600022"
                  },
                  "shipping_address": {
                    "country": "JP",
                    "email": "customer@example.com",
                    "address1": "1-2-3 Shinjuku",
                    "phone_number": "8112345678",
                    "city": "Shinjuku-ku",
                    "state": "Tokyo",
                    "postal_code": "1600022"
                  },
                  "time_zone": "Asia/Kuala_Lumpur"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "GCash決済取引が作成され、決済ページURLが返されました。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "取引参照ID。",
                      "example": "2ae6f7db-7a52-495d-b816-98b57d9b5c68"
                    },
                    "url": {
                      "type": "string",
                      "description": "GCash決済ページのURL。",
                      "example": "https://payment.moneycollect.com/authentication?type=2&param=<TOKEN>"
                    },
                    "amount": {
                      "type": "number",
                      "description": "取引金額。",
                      "example": 200
                    },
                    "currency": {
                      "type": "string",
                      "description": "決済処理通貨。",
                      "example": "USD"
                    },
                    "merchant_txn_ref": {
                      "type": "string",
                      "description": "加盟店の取引参照ID。",
                      "example": "ORDER-12345",
                      "nullable": true
                    },
                    "merchant_id": {
                      "type": "string",
                      "description": "取引に使用した加盟店ID。",
                      "example": "<DASMID>"
                    },
                    "merchant_email": {
                      "type": "string",
                      "description": "加盟店のメールアドレス（取得できる場合）。",
                      "nullable": true
                    },
                    "return_url": {
                      "type": "object",
                      "description": "取引結果に応じたリターンURL。",
                      "properties": {
                        "webhook_url": {
                          "type": "string",
                          "description": "通知を受信するWebhook URL。",
                          "example": "https://merchant.example.com/webhook"
                        },
                        "success_url": {
                          "type": "string",
                          "description": "決済成功時のリダイレクトURL。",
                          "example": "https://merchant.example.com/success"
                        },
                        "decline_url": {
                          "type": "string",
                          "description": "決済失敗時のリダイレクトURL。",
                          "example": "https://merchant.example.com/decline"
                        },
                        "cancel_url": {
                          "type": "string",
                          "description": "決済キャンセル時のリダイレクトURL。",
                          "example": "https://merchant.example.com/cancel"
                        }
                      }
                    },
                    "billing_address": {
                      "type": "object",
                      "description": "請求先住所の詳細。",
                      "properties": {
                        "city": {
                          "type": "string",
                          "description": "請求先市区町村。",
                          "example": "Shinjuku-ku"
                        },
                        "email": {
                          "type": "string",
                          "description": "請求先メールアドレス。",
                          "example": "customer@example.com"
                        },
                        "state": {
                          "type": "string",
                          "description": "請求先都道府県・州。",
                          "example": "Tokyo"
                        },
                        "country": {
                          "type": "string",
                          "description": "請求先国コード。",
                          "example": "JP"
                        },
                        "address1": {
                          "type": "string",
                          "description": "請求先住所（番地など）。",
                          "example": "1-2-3 Shinjuku"
                        },
                        "postal_code": {
                          "type": "string",
                          "description": "請求先郵便番号。",
                          "example": "1600022"
                        },
                        "phone_number": {
                          "type": "string",
                          "description": "請求先電話番号。",
                          "example": "8112345678"
                        }
                      }
                    },
                    "shipping_address": {
                      "type": "object",
                      "description": "配送先住所の詳細。",
                      "properties": {
                        "city": {
                          "type": "string",
                          "description": "配送先市区町村。",
                          "example": "Shinjuku-ku"
                        },
                        "email": {
                          "type": "string",
                          "description": "配送先メールアドレス。",
                          "example": "customer@example.com"
                        },
                        "state": {
                          "type": "string",
                          "description": "配送先都道府県・州。",
                          "example": "Tokyo"
                        },
                        "country": {
                          "type": "string",
                          "description": "配送先国コード。",
                          "example": "JP"
                        },
                        "address1": {
                          "type": "string",
                          "description": "配送先住所（番地など）。",
                          "example": "1-2-3 Shinjuku"
                        },
                        "postal_code": {
                          "type": "string",
                          "description": "配送先郵便番号。",
                          "example": "1600022"
                        },
                        "phone_number": {
                          "type": "string",
                          "description": "配送先電話番号。",
                          "example": "8112345678"
                        }
                      }
                    },
                    "redirecturl": {
                      "type": "string",
                      "description": "お客様をリダイレクトするために返されるGCash決済ページURL。",
                      "example": "https://payment.moneycollect.com/authentication?type=2&param=<TOKEN>"
                    }
                  },
                  "example": {
                    "id": "2ae6f7db-7a52-495d-b816-98b57d9b5c68",
                    "url": "https://payment.moneycollect.com/authentication?type=2&param=<TOKEN>",
                    "amount": 200,
                    "currency": "USD",
                    "merchant_txn_ref": null,
                    "merchant_id": "<DASMID>",
                    "merchant_email": null,
                    "return_url": {
                      "webhook_url": "https://merchant.example.com/webhook",
                      "success_url": "https://merchant.example.com/success",
                      "decline_url": "https://merchant.example.com/decline",
                      "cancel_url": "https://merchant.example.com/cancel"
                    },
                    "billing_address": {
                      "city": "Shinjuku-ku",
                      "email": "customer@example.com",
                      "state": "Tokyo",
                      "country": "JP",
                      "address1": "1-2-3 Shinjuku",
                      "postal_code": "1600022",
                      "phone_number": "8112345678"
                    },
                    "shipping_address": {
                      "city": "Shinjuku-ku",
                      "email": "customer@example.com",
                      "state": "Tokyo",
                      "country": "JP",
                      "address1": "1-2-3 Shinjuku",
                      "postal_code": "1600022",
                      "phone_number": "8112345678"
                    },
                    "redirecturl": "https://payment.moneycollect.com/authentication?type=2&param=<TOKEN>"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "認証用APIキー。形式：'Basic YOUR_API_KEY_HERE'。"
      },
      "xApiKeyAuth": {
        "type": "apiKey",
        "name": "x-api-key",
        "in": "header",
        "description": "x-api-keyヘッダー専用のAPIキー。"
      }
    }
  }
}
